<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Summary.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Summary.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="using:Summary.ViewModels"
      xmlns:converters="using:Summary.Converters"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance viewmodels:SettingsViewModel}">
    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Page.Resources>

    <StackPanel Orientation="Vertical"
                Margin="36,40"
                Spacing="24">

        <TextBlock Text="Settings"
                   Style="{StaticResource TitleTextBlockStyle}" />

        <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                CornerRadius="4"
                Padding="16"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            Spacing="4">
                    <TextBox Header="Ollama URL"
                             PlaceholderText="http://localhost:11434"
                             Text="{Binding OllamaUrl, Mode=TwoWay}" />
                </StackPanel>
                <Button x:Name="ValidateOllamaButton"
                        Content="Check"
                        Command="{Binding ValidateOllamaUrlCommand}"
                        VerticalAlignment="Bottom"
                        Grid.Column="1" />
                <ComboBox x:Name="OllamaModelsComboBox"
                          Header="Ollama Model"
                          PlaceholderText="Select a model"
                          IsEnabled="{Binding IsOllamaURLValid, Mode=OneWay}"
                          Width="220"
                          Grid.Column="2" />
                <Button x:Name="SaveModelButton"
                        Content="Save"
                        VerticalAlignment="Bottom"
                        IsEnabled="{Binding IsOllamaURLValid, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Grid.Column="3" />
            </Grid>
        </Border>
    </StackPanel>
</Page>
