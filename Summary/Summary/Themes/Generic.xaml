<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Summary.Controls">

    <Style TargetType="controls:OverlayControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:OverlayControl">
                    <Grid>
                        <ContentPresenter />
                        <Grid x:Name="OverlayGrid" Background="#80000000">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="16">
                                <ProgressRing IsActive="True"
                                              HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding BusyMessage}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="WrapWholeWords"
                                           Foreground="White"
                                           MaxWidth="420" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>